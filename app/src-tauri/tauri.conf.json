{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "리셋권 알림",
  "version": "0.1.0",
  "identifier": "io.github.joseph-kang777.resetnoti",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "리셋권 알림",
        "width": 900,
        "height": 720,
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/claude.png": "icons/claude.png",
      "icons/codex.png": "icons/codex.png"
    }
  },
  "mainBinaryName": "reset-noti"
}